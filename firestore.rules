rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Datos privados sensibles (email, teléfono): solo el titular
    match /users_private/{userId} {
      allow read, create, update: if isOwner(userId);
    }

    // Clientes invitados (Anonymous Auth): lectura autenticada para búsqueda por código de recuperación (sin PII)
    match /guest_clients/{guestId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(guestId);
    }

    // Perfiles públicos de repartidores
    match /couriers_public/{courierId} {
      allow read: if true;
      allow create, update: if isOwner(courierId);

      match /tariffs/{tariffId} {
        allow read: if true;
        allow create, update, delete: if isOwner(courierId);
      }
    }

    // Comercios registrados
    match /merchants/{merchantId} {
      allow read: if true;
      allow create, update: if isOwner(merchantId);
    }

    // Favoritos privados del usuario
    match /users/{userId}/favorites/{courierId} {
      allow read, write: if isOwner(userId);
    }

    // Conversaciones privadas y mensajes (soporta recuperación anónima por código)
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participantIds ||
        (resource.data.clientRecoveryCode is string && resource.data.clientRecoveryCode.size() >= 6)
      );
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participantIds ||
        (
          resource.data.clientRecoveryCode is string &&
          resource.data.clientRecoveryCode.size() >= 6 &&
          request.resource.data.clientRecoveryCode == resource.data.clientRecoveryCode &&
          request.resource.data.courierId == resource.data.courierId &&
          request.resource.data.clientId == request.auth.uid &&
          request.auth.uid in request.resource.data.participantIds
        )
      );

      match /messages/{messageId} {
        allow read, create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    // Contrataciones (solo participantes + recuperación anónima por código)
    match /contracts/{contractId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.clientId ||
        request.auth.uid == resource.data.courierId ||
        (resource.data.clientRecoveryCode is string && resource.data.clientRecoveryCode.size() >= 6)
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.clientId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.clientId ||
        request.auth.uid == resource.data.courierId ||
        (
          resource.data.clientRecoveryCode is string &&
          resource.data.clientRecoveryCode.size() >= 6 &&
          request.resource.data.clientRecoveryCode == resource.data.clientRecoveryCode &&
          request.resource.data.courierId == resource.data.courierId &&
          request.resource.data.clientId == request.auth.uid
        )
      );
    }

    // Valoraciones verificadas (1 por contrato completado, solo cliente contratante)
    match /ratings/{contractId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.clientId &&
        get(/databases/$(database)/documents/contracts/$(contractId)).data.status == 'completed' &&
        get(/databases/$(database)/documents/contracts/$(contractId)).data.clientId == request.auth.uid;
    }

    // Oportunidades laborales de comercios
    match /job_opportunities/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.merchantId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.merchantId;
    }
  }
}
